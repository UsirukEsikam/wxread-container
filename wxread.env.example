# Runtime timezone and five-field cron schedule.
TZ=Asia/Shanghai
CRON_SCHEDULE=0 1 * * *

# Upstream wxread settings. Each READ_NUM is about 30 seconds.
READ_NUM=40

# Required. Paste the one-line "Copy as cURL (bash)" value after '='.
WXREAD_CURL_BASH=curl 'https://weread.qq.com/web/book/read' ...

# Bark. Leave BARK_KEY empty to disable Bark notifications.
BARK_SERVER=https://api.day.app
BARK_KEY=
BARK_GROUP=wxread
